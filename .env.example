# Reverse-proxy host allowlist for vite dev/preview servers (comma-separated).
# Vite blocks non-localhost Host headers by default; set your proxy domain here
# or in .env.local (gitignored).
# VITE_ALLOWED_HOSTS=gallery.example.com,gallery.example.com:8443

# Real deployment URL injected into served userscripts (auto-update support).
# Leave unset for vanilla checkouts — files are served with template domains.
# GALLERY_PUBLIC_URL=https://gallery.example.com:8443
